#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct Product {
    int id;
    char name[50];
    double price;
    int quantity;
    struct Product* next;
} Product;

// Global Inventory (Available products to buy)
Product inventory[5] = {
    {101, "Laptop", 850.00, 10, NULL},
    {102, "Smartphone", 500.00, 15, NULL},
    {103, "Headphones", 50.00, 30, NULL},
    {104, "Smartwatch", 150.00, 20, NULL},
    {105, "Keyboard", 35.00, 25, NULL}
};

// Function prototypes
void displayInventory();
void addToCart(Product** cart, int id, int qty);
void removeFromCart(Product** cart, int id);
void viewCart(Product* cart);
void checkout(Product** cart);

void displayInventory() {
    printf("\n--- Available Products ---\n");
    printf("ID\tName\t\tPrice\t\tStock\n");
    for (int i = 0; i < 5; i++) {
        printf("%d\t%-12s\t$%-8.2f\t%d\n", inventory[i].id, inventory[i].name, inventory[i].price, inventory[i].quantity);
    }
}

void addToCart(Product** cart, int id, int qty) {
    int idx = -1;
    for (int i = 0; i < 5; i++) {
        if (inventory[i].id == id) {
            idx = i;
            break;
        }
    }

    if (idx == -1) {
        printf("❌ Product ID not found!\n");
        return;
    }

    if (inventory[idx].quantity < qty) {
        printf("❌ Out of stock! Only %d items left.\n", inventory[idx].quantity);
        return;
    }

    // Check if item already exists in cart
    Product* temp = *cart;
    while (temp != NULL) {
        if (temp->id == id) {
            temp->quantity += qty;
            inventory[idx].quantity -= qty;
            printf("✅ Updated quantity in cart.\n");
            return;
        }
        temp = temp->next;
    }

    // Allocate dynamic node if it's a new item in the cart
    Product* newItem = (Product*)malloc(sizeof(Product));
    newItem->id = id;
    strcpy(newItem->name, inventory[idx].name);
    newItem->price = inventory[idx].price;
    newItem->quantity = qty;
    newItem->next = *cart; 
    *cart = newItem; // Insert at head

    inventory[idx].quantity -= qty;
    printf("✅ Item added to cart successfully.\n");
}

void removeFromCart(Product** cart, int id) {
    Product *temp = *cart, *prev = NULL;

    while (temp != NULL && temp->id != id) {
        prev = temp;
        temp = temp->next;
    }

    if (temp == NULL) {
        printf("❌ Item not found in cart!\n");
        return;
    }

    // Return the items back to main stock inventory
    for (int i = 0; i < 5; i++) {
        if (inventory[i].id == id) {
            inventory[i].quantity += temp->quantity;
            break;
        }
    }

    if (prev == NULL) {
        *cart = temp->next;
    } else {
        prev->next = temp->next;
    }

    free(temp);
    printf("🗑️ Item removed from cart.\n");
}

void viewCart(Product* cart) {
    if (cart == NULL) {
        printf("\n🛒 Your cart is completely empty!\n");
        return;
    }

    printf("\n--- Your Shopping Cart ---\n");
    printf("ID\tName\t\tPrice\t\tQty\tTotal\n");
    double grandTotal = 0;
    while (cart != NULL) {
        double cost = cart->price * cart->quantity;
        grandTotal += cost;
        printf("%d\t%-12s\t$%-8.2f\t%d\t$%-8.2f\n", cart->id, cart->name, cart->price, cart->quantity, cost);
        cart = cart->next;
    }
    printf("-------------------------------------------\n");
    printf("Grand Total: $%.2f\n", grandTotal);
}

void checkout(Product** cart) {
    if (*cart == NULL) {
        printf("❌ Your cart is empty. Nothing to checkout!\n");
        return;
    }
    
    viewCart(*cart);
    printf("\n💳 Processing payment... Thank you for shopping with us!\n");
    
    // Free the linked list memory
    Product* current = *cart;
    Product* nextNode;
    while (current != NULL) {
        nextNode = current->next;
        free(current);
        current = nextNode;
    }
    *cart = NULL; 
}

int main() {
    Product* cart = NULL;
    int choice, id, qty;

    while (1) {
        printf("\n======= ONLINE SHOPPING SYSTEM =======");
        printf("\n1. View Products\n2. Add to Cart\n3. Remove from Cart\n4. View Cart\n5. Checkout & Exit\n6. Exit without Buying\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                displayInventory();
                break;
            case 2:
                displayInventory();
                printf("Enter Product ID to add: ");
                scanf("%d", &id);
                printf("Enter Quantity: ");
                scanf("%d", &qty);
                addToCart(&cart, id, qty);
                break;
            case 3:
                viewCart(cart);
                if (cart != NULL) {
                    printf("Enter Product ID to remove: ");
                    scanf("%d", &id);
                    removeFromCart(&cart, id);
                }
                break;
            case 4:
                viewCart(cart);
                break;
            case 5:
                checkout(&cart);
                exit(0);
            case 6:
                printf("Goodbye!\n");
                exit(0);
            default:
                printf("❌ Invalid Choice! Please try again.\n");
        }
    }
    return 0;
}

